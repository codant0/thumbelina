# Thumbelina default configuration
# Override values with THUMBELINA_* environment variables

llm:
  provider: openai
  model: gpt-4o
  api_key: ${OPENAI_API_KEY}
  # base_url: https://api.openai.com/v1  # Optional: custom API endpoint for OpenAI-compatible providers
  # request_timeout: null                 # Optional: LLM request timeout in seconds
  # streaming_enabled: true               # Optional: enable WebSocket streaming responses

# cors_origins: ["*"]                     # Optional: CORS allowed origins; restrict in production

auth:
  secret_key: ""             # JWT signing key; Bearer auth enabled when non-empty
  # required_roles: []       # Global role list; empty = all authenticated users allowed

rate_limit:
  enabled: false
  max_requests: 60
  window_seconds: 60

memory:
  database_url: sqlite:///thumbelina.db

logging:
  level: INFO

channels:
  qq:
    enabled: false
    app_id: ""
    app_secret: ""
  wechat:
    enabled: false
    bot_token: ""              # Bot token from iLink (auto-populated after QR code login)
    ilink_bot_id: ""           # iLink bot ID
    ilink_user_id: ""          # iLink user ID
    ilink_base_url: "https://ilinkai.weixin.qq.com"
    webhook_secret: ""
