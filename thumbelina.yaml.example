# Thumbelina default configuration
# Override values with THUMBELINA_* environment variables.
#
# NOTE: `llm` and `auth` are intentionally minimal here — neither is
# required at startup, and both are obtained after boot instead:
#
#   - llm:   managed at runtime through the config database / REST API
#            (Web UI "Settings": LLM endpoints & presets,
#            PUT /api/v1/config/llm, POST /api/v1/config/llm/endpoints...).
#            The service starts fine without any LLM credentials; the
#            provider is activated lazily on first use. Only
#            `llm.context_window` is set below as the fallback default
#            context window for the active model.
#   - auth:  disabled by default (empty secret_key). Secrets are never
#            stored in the config database; to enable JWT auth set the
#            environment variable THUMBELINA_AUTH__SECRET_KEY (>= 32 bytes)
#            and restart. Non-sensitive auth options (e.g. required_roles)
#            can be changed at runtime via POST /api/v1/config.

rate_limit:
  enabled: false
  max_requests: 60
  window_seconds: 60

repository:
  database_url: sqlite:///thumbelina.db

logging:
  level: INFO

# TODO module: local Markdown-based todo list & quick notes
todo:
  enabled: true
  directory: TODO

# Memory module: Markdown file-system backed layered memory (L0/L1/L2).
# 索引 index.md 为自动生成的派生产物,请勿手工编辑;直接改各分类下
# 的记忆文档,索引会在写入时重建。本期单用户(user_id 固定 "default")。
memory:
  enabled: true               # 关闭后路由与注入整体禁用
  directory: MEMORY           # Markdown 记忆目录,相对路径基于工作目录
  categories: [user, project, decision, topic]  # 分类白名单(索引分组顺序)
  inject_index: true          # 每轮注入索引摘要(L0 triage)
  inject_top_k: 8             # 索引超过阈值时按相关性注入前 K 条
  index_token_cap: 3000        # 索引摘要全量注入的 token 上限(estimate_tokens 口径)
  max_full_tokens: 4000       # read_full 单条全文注入上限,超限截断
  max_entries: 200            # 记忆条目总量护栏
  max_total_bytes: 5_000_000  # 记忆目录总字节护栏
  extract:
    enabled: true             # 后台 LLM 抽取/改写(阶段二接线)
    on_user_message: true     # 仅对用户消息触发抽取
    min_message_chars: 16     # 消息低于该字符数不触发抽取(排除"好的/谢谢"等语气词)
    max_input_tokens: 8000    # 单次抽取输入 token 预算
  tools:
    enabled: true             # 暴露 search_memory/read_memory/remember

# Default context window of the active LLM model. Individual endpoints can
# override this via their own context_window field (Web UI "Settings").
# Supports K (thousand) / M (million) token suffixes, case-insensitive.
llm:
  context_window: "128K"

# Conversation context (checkpointer) compression
context:
  compress:
    strategy: summary_recent   # sliding_window | full_summary | summary_recent
    threshold: 0.8             # trigger compression when usage hits 80% of the window
    recent_turns: 6            # recent turns kept verbatim by summary_recent
